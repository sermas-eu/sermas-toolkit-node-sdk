{
  "name": "@sermas/sermas-toolkit-node-sdk",
  "version": "1.0.0-alpha.123",
  "description": "Sermas toolkit node SDK",
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./auth": {
      "types": "./auth.d.ts",
      "import": "./auth.js",
      "require": "./auth.cjs"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sermas-eu/sermas-toolkit-node-sdk.git"
  },
  "scripts": {
    "clean": "rm -rf ./dist",
    "build": "npm run clean && tsup && cp package.json README.md LICENSE dist/",
    "build:watch": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@sermas/api-client": "^2.0.0",
    "axios": "^1.21.0",
    "eventemitter2": "^6.4.9",
    "jwt-decode": "^4.0.0",
    "mqtt": "^5.16.1",
    "openai": "^7.53.0",
    "ulidx": "^2.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.1"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  }
}
