{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "types": ["node", "vitest/globals"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "declaration": false,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    // @sermas/api-client from its sources (sermas-api-client checkout beside this one)
    "paths": {
      "@sermas/api-client": ["../sermas-api-client/src/index.ts"]
    }
  },
  "include": ["src"]
}
